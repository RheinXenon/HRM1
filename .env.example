# ================================
# LLM API 配置
# ================================
# 使用 iflow API 配置
QWEN_API_KEY=your_api_key
QWEN_API_URL=your_api_url
QWEN_MODEL=qwen3-max

# ================================
# 数据库配置 暂时没用
# ================================
DATABASE_PATH=data/interview_system.db

# ================================
# 面试配置
# ================================
# 默认面试模式: demo / full
DEFAULT_INTERVIEW_MODE=demo

# 批量执行最大并发数
MAX_CONCURRENT_INTERVIEWS=3

# ================================
# 日志配置
# ================================
LOG_LEVEL=INFO
LOG_FILE=data/app.log

# ================================
# Streamlit 前端配置（可选）
# ================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
